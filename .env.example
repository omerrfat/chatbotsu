# Copy to .env and fill in. NEVER commit .env.
# LLM: leave ANTHROPIC_API_KEY empty to use the offline mock provider.
ANTHROPIC_API_KEY=
LLM_PROVIDER=            # anthropic | mock (auto: anthropic if key set)
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=500

DB_PATH=data/chatbot.db
RATE_LIMIT=20            # chat messages per IP per minute

# Admin log viewer at /admin (disabled unless set)
ADMIN_PASSWORD=

# Owner notifications (only for tenants using that type)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
